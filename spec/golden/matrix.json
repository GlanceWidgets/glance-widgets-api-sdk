              "#F00"
            ],
            [
              "ellipse",
              1,
              1,
              3,
              3,
              "#0F0"
            ],
            [
              "roundRect",
              0,
              0,
              4,
              4,
              1,
              "#00F",
              {
                "fill": false
              }
            ],
            [
              "arc",
              1,
              1,
              1,
              0,
              90,
              "#FFF"
            ],
            [
              "polygon",
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
