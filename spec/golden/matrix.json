[
  {
    "name": "empty default, single color shorthand is inlined",
    "call": {
      "fn": "matrix",
      "args": [
        {
          "columns": 3,
          "rows": 2,
          "ops": [
            [
              "set",
              1,
              0,
              "#f00"
            ]
          ]
        }
      ]
    },
    "expected": {
      "pixels": [
        [
          null,
          {
            "color": "#FF0000",
            "opacity": 1,
            "cornerRadius": 0,
            "rotation": 0,
            "halo": 0
          },
          null
        ],
        [
          null,
          null,
          null
        ]
      ],
      "default": {
        "empty": true
      },
      "layout": {
        "gapMode": "default",
        "edgeInsetRatio": 0,
        "cellAspectRatio": 1
      }
    }
  },
  {
    "name": "repeated style becomes batch, coordinates are [row, col]",
    "call": {
      "fn": "matrix",
      "args": [
        {
          "columns": 4,
          "rows": 3,
          "ops": [
            [
              "set",
              0,
              0,
              "#FF0000"
            ],
            [
              "set",
              3,
              2,
              "#FF0000"
            ],
            [
              "set",
              1,
              1,
              {
                "color": "#00FF00",
                "opacity": 0.5
              }
            ]
          ]
        }
      ]
    },
    "expected": {
      "pixels": [
        [
          null,
          null,
          null,
          null
        ],
        [
          null,
          {
            "color": "#00FF00",
            "opacity": 0.5,
            "cornerRadius": 0,
            "rotation": 0,
            "halo": 0
          },
          null,
          null
        ],
        [
          null,
          null,
          null,
          null
        ]
      ],
      "default": {
        "empty": true
      },
      "layout": {
        "gapMode": "default",
        "edgeInsetRatio": 0,
        "cellAspectRatio": 1
      },
      "batch": [
        {
          "pixel": {
            "color": "#FF0000",
            "opacity": 1,
            "cornerRadius": 0,
            "rotation": 0,
            "halo": 0
          },
          "coordinates": [
            [
              0,
              0
            ],
            [
              2,
              3
            ]
          ]
        }
      ]
    }
  },
  {
    "name": "cells equal to a visible default become null",
    "call": {
      "fn": "matrix",
      "args": [
        {
          "columns": 3,
          "rows": 2,
          "options": {
            "default": {
              "color": "#0A2D48",
              "opacity": 0.3,
              "cornerRadius": 0.2
            }
          },
          "ops": [
            [
              "fill",
              "#0A2D48"
            ],
            [
              "set",
              2,
              1,
              "#FFFFFF"
            ],
            [
              "set",
              0,
              1,
              "empty"
            ]
          ]
        }
      ]
    },
    "expected": {
      "pixels": [
        [
          null,
          null,
          null
        ],
        [
          {
            "empty": true
          },
          null,
          {
            "color": "#FFFFFF",
            "opacity": 0.3,
            "cornerRadius": 0.2,
            "rotation": 0,
            "halo": 0
          }
        ]
      ],
      "default": {
        "color": "#0A2D48",
        "opacity": 0.3,
        "cornerRadius": 0.2,
        "rotation": 0,
        "halo": 0
      },
      "layout": {
        "gapMode": "default",
        "edgeInsetRatio": 0,
        "cellAspectRatio": 1
      }
    }
  },
