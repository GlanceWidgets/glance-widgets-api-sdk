  {
    "name": "led matrix export",
    "call": {
      "fn": "matrix",
      "args": [
        {
          "columns": 3,
          "rows": 2,
          "theme": "led",
          "ops": [
            [
              "set",
              0,
              0,
              "#FF4D2E"
            ],
            [
              "set",
              1,
              0,
              "#FFD23F"
            ],
            [
              "set",
              2,
              1,
              "#FF4D2E"
            ]
          ]
        }
      ]
    },
    "expected": {
      "pixels": [
        [
          null,
          {
            "color": "#FFD23F",
            "opacity": 1,
            "cornerRadius": 0.5,
            "rotation": 0,
            "halo": 0.6
          },
          null
        ],
        [
          null,
          null,
          null
        ]
      ],
      "default": {
        "color": "#3A1F1B",
        "opacity": 0.3,
        "cornerRadius": 0.5,
        "rotation": 0,
        "halo": 0
      },
      "layout": {
        "gapMode": "far",
        "edgeInsetRatio": 0,
        "cellAspectRatio": 1
      },
      "batch": [
        {
          "pixel": {
            "color": "#FF4D2E",
            "opacity": 1,
            "cornerRadius": 0.5,
            "rotation": 0,
            "halo": 0.6
          },
          "coordinates": [
            [
              0,
              0
            ],
            [
              1,
              2
            ]
          ]
        }
      ]
    }
  },
  {
