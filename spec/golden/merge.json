[
  {
    "name": "data deep path merge, later leaf wins, arrays are leaves",
    "call": {
      "fn": "merge",
      "args": [
        {
          "data": {
            "a": {
              "x": 1,
              "list": [
                1,
                2
              ]
            },
            "b": 1
          }
        },
        {
          "data": {
            "a": {
              "y": 2,
              "list": [
                3
              ]
            },
            "b": {
              "nested": true
            }
          }
        }
      ]
    },
    "expected": {
      "protocol": 1,
      "data": {
        "a": {
          "x": 1,
          "list": [
            3
          ],
          "y": 2
        },
        "b": {
          "nested": true
        }
      }
    }
  },
