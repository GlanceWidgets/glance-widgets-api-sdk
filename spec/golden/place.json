          "cpu": {
            "frame": {
              "left": 0.1,
              "top": 0.2,
              "width": 0.5,
              "height": 0.3
            },
            "content": {
              "pixels": [
                [
                  null,
                  null,
                  null
                ],
                [
                  null,
                  null,
                  null
                ]
              ],
              "default": {
                "empty": true
              },
              "layout": {
                "gapMode": "near",
                "edgeInsetRatio": 0,
                "cellAspectRatio": 1
              },
              "batch": [
                {
                  "pixel": {
                    "color": "#FF0000",
                    "opacity": 1,
                    "cornerRadius": 0,
                    "rotation": 0,
                    "halo": 0
                  },
                  "coordinates": [
                    [
                      0,
                      0
                    ],
                    [
                      1,
                      2
                    ]
                  ]
                }
              ]
            },
            "style": {},
            "zIndex": 2
          }
        }
      }
    }
  },
