          },
          "ops": [
            [
              "set",
              0,
              0,
              "#FF0000"
            ],
            [
              "set",
              2,
              1,
              "#FF0000"
            ]
          ]
        },
        {
          "id": "cpu",
          "frame": {
            "left": 0.1,
            "top": 0.2,
            "width": 0.5,
            "height": 0.3
          },
          "path": "data.charts.cpu",
          "zIndex": 2
        }
      ]
    },
    "expected": {
