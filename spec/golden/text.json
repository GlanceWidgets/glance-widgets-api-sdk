[
  {
    "name": "measure empty string",
    "call": {
      "fn": "measureText",
      "args": [
        "",
        "3x5"
      ]
    },
    "expected": {
      "width": 0,
      "height": 5,
      "lines": [
        ""
      ]
    }
  },
  {
    "name": "measure 3x5 digits",
    "call": {
      "fn": "measureText",
      "args": [
        "12:30",
        "3x5"
      ]
    },
    "expected": {
      "width": 17,
      "height": 5,
      "lines": [
        "12:30"
      ]
    }
  },
  {
    "name": "measure 5x7 with a descender",
    "call": {
      "fn": "measureText",
      "args": [
        "gap",
        "5x7"
      ]
    },
    "expected": {
      "width": 17,
      "height": 8,
      "lines": [
        "gap"
      ]
    }
  },
  {
    "name": "measure 5x7 without a descender",
    "call": {
      "fn": "measureText",
      "args": [
        "HELLO",
        "5x7"
      ]
    },
    "expected": {
      "width": 29,
      "height": 7,
      "lines": [
        "HELLO"
      ]
    }
  },
  {
    "name": "measure multiple lines",
    "call": {
      "fn": "measureText",
      "args": [
        "AB\nC",
        "3x5"
      ]
    },
    "expected": {
      "width": 7,
      "height": 11,
      "lines": [
        "AB",
        "C"
      ]
    }
  },
  {
    "name": "measure multi-line with a descender only on the last line",
    "call": {
      "fn": "measureText",
      "args": [
        "AB\ngp",
        "5x7"
      ]
    },
    "expected": {
      "width": 11,
      "height": 17,
      "lines": [
        "AB",
        "gp"
      ]
    }
  },
  {
    "name": "measure with letter and line spacing",
    "call": {
      "fn": "measureText",
      "args": [
        "AB\nC",
        "3x5",
        {
          "letterSpacing": 2,
          "lineSpacing": 0
        }
      ]
    },
    "expected": {
      "width": 8,
      "height": 10,
      "lines": [
        "AB",
        "C"
      ]
    }
  },
  {
    "name": "measure wraps at word boundaries",
    "call": {
      "fn": "measureText",
      "args": [
        "HELLO WORLD NOW",
        "3x5",
        {
          "maxWidth": 20
        }
      ]
    },
    "expected": {
      "width": 19,
      "height": 17,
      "lines": [
        "HELLO",
        "WORLD",
        "NOW"
      ]
    }
  },
  {
    "name": "measure splits a word longer than maxWidth",
    "call": {
      "fn": "measureText",
      "args": [
        "ABCDEFGH",
        "3x5",
        {
          "maxWidth": 11
        }
      ]
    },
    "expected": {
      "width": 11,
      "height": 17,
      "lines": [
        "ABC",
        "DEF",
        "GH"
      ]
    }
  },
  {
    "name": "measure inline custom font",
    "call": {
      "fn": "measureText",
      "args": [
        "你好",
        {
          "name": "mini-cjk",
          "height": 4,
          "spacing": 0,
          "advance": 5,
          "fallback": "?",
          "glyphs": {
            "你": [
              "#.#.",
              "####",
              "#..#",
              ".##."
            ],
            "好": [
              ".##.",
              "#..#",
              "####",
              "#..#"
            ],
            "?": [
              "###.",
              "..#.",
              ".#..",
              ".#.."
            ]
          }
        }
      ]
    },
    "expected": {
      "width": 10,
      "height": 4,
      "lines": [
        "你好"
      ]
    }
  },
  {
    "name": "measure unknown font throws",
    "call": {
      "fn": "measureText",
      "args": [
        "A",
        "nope"
      ]
    },
    "throws": true
  },
  {
    "name": "measure unsupported character without fallback throws",
    "call": {
      "fn": "measureText",
      "args": [
        "x",
        {
          "name": "proportional-demo",
          "height": 3,
          "descent": 1,
          "glyphs": {
            "i": [
              "#",
              ".",
              "#"
            ],
            "g": [
              "##",
              "#.",
              "##",
              ".#"
            ],
            "W": [
              "#.#",
              "#.#",
              "###"
            ],
            " ": {
              "rows": [],
              "advance": 2
            }
          }
        }
      ]
    },
    "throws": true
  },
